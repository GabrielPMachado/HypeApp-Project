# Copie este arquivo para ".env" e preencha com as credenciais reais
# do projeto Firebase (Console > Configurações do projeto > SDK Web).
# NUNCA commite o arquivo ".env" com valores reais.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Client ID Web do OAuth do Google (Firebase Console > Authentication >
# Sign-in method > Google > Configuração do SDK Web) — habilita o botão
# "Continuar com Google". Sem essa variável, o app funciona normalmente
# só com e-mail/senha.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Geoapify (mapa estático na tela de detalhes do bar, geocodificação da
# busca livre de região) — chave gratuita em https://www.geoapify.com/
# (Projects / API Keys), sem cartão de crédito.
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Google Maps (mapa de calor interativo na aba Mapa) — só usada no Android.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opcional: Map ID de um estilo vetorial (Google Cloud Console > Google
# Maps Platform > Map Management) — só com mapa vetorial os prédios
# aparecem em 3D de verdade. Sem essa variável, o mapa cai pro estilo
# JSON clássico embutido no código (2D, sem prédio 3D).
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
