# Copie este arquivo para ".env" e preencha com as credenciais reais
# do projeto Firebase (Console > Configurações do projeto > SDK Web).
# NUNCA commite o arquivo ".env" com valores reais.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Geoapify (mapa estático na tela de detalhes do bar) — chave gratuita em
# https://www.geoapify.com/ (Projects / API Keys), sem cartão de credito.
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Google Maps (mapa de calor interativo na aba Mapa, via react-native-maps)
# — só é usada no Android; no iOS o mapa nativo (Apple Maps) não precisa
# de chave. Crie em https://console.cloud.google.com/google/maps-apis,
# ative a "Maps SDK for Android" e gere uma chave (pode restringir por
# nome de pacote depois; sem restrição funciona direto no Expo Go pra
# testar). Sem essa chave o Android mostra o mapa quase em branco — os
# círculos de hype e os pontos dos bares ainda aparecem normalmente.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
