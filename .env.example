# Copie este arquivo para ".env" e preencha com as credenciais reais
# do projeto Firebase (Console > Configurações do projeto > SDK Web).
# NUNCA commite o arquivo ".env" com valores reais.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Geoapify (mapa estático na tela de detalhes do bar) — chave gratuita em
# https://www.geoapify.com/ (Projects / API Keys), sem cartão de credito.
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Google Maps (mapa de calor interativo na aba Mapa) — só usada no Android.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID (Google Cloud Console > Google Maps Platform > Map Management)
# com um estilo vetorial associado — sem isso, o mapa cai pro estilo
# JSON clássico embutido no código (mais simples, sem prédios 3D).
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
